#include "common.h"
#include "sload.h"

// Check Addons
#include "check_screenspace.h"

float4 pda_params;

float4 main( p_flat I ) : SV_Target
{
	float brightness = pda_params.x;

	// Vanilla
	float4 color = float4(brightness, brightness, brightness, 0);

#ifdef SSFX_ENHANCED_SHADERS
	float3 D = tbase(I.tcdh);
	D = SRGBToLinear(D);
	
	color = float4(D.rgb, 1);
	color.w *= brightness;
#endif

	return color;
}