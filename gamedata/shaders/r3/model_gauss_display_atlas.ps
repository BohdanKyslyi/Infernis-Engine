#include "common.h"
#include "gs_weapon_computer.h"

Texture2D s_gauss_mui_13;
float4 main(float2 uv : TEXCOORD0) : SV_Target
{
    float4 texel = s_base.Sample(smp_base, uv);
    if (weapon_computer_display.w == 13.0)
        texel = s_gauss_mui_13.Sample(smp_base, uv);
    texel.rgb = saturate(texel.rgb + weapon_computer_noise(uv));
    return texel;
}
