#include "screenspace_common.h"
#include "screenspace_fog.h"

static const float2 dband_dir_Offsets[4] =
{
	float2( 1, 1),	// XOX
	float2(-1,-1),	// O0O
	float2(-1, 1),	// XOX
	float2( 1,-1)	
};

float4 ssfx_scattering_setup;

void dband_process_fog(inout float3 color, float2 tc, float noise, float2 dir, float loop_step)
{
	// Some vars
	float3 sampled_pixel;
	float3 diff;
	float3 avg = 0, max_diff = 0;

	float pixel_factor = loop_step / 2;

	// Radius for the sample
	float radius = noise * (48 * pixel_factor * pixel_factor) * ssfx_pixel_size;

	// Sample 4 points arround the original pixel
	[unroll (4)]
	for (int taps = 0; taps <= 4; taps++)
	{
		// Sample pixel
		sampled_pixel = s_blur_2.Sample(smp_linear, tc + radius * (dir * dband_dir_Offsets[taps])).rgb;
		
		// Add to the average
		avg += sampled_pixel;

		// Difference between original pixel and sampled pixel
		diff = abs(color - sampled_pixel);

		// From the 4 samples save the biggest difference
		max_diff = max(max_diff, diff);
	}
	 
	// Normalize average
	avg /= 4.0f;

	// Difference between original pixel and average
	diff = abs(color - avg);

	// Calc how much the pixel difference is close to our threshold.
	float3 threshold = saturate((1.0 - diff  / 0.039215f) * 3.0f) * saturate((1.0 - max_diff  / 0.039215f) * 3.0f);

	// We use the original pixel or average?
	color = lerp(color, avg, threshold);
}

float3 ssfx_debanding_fog(float3 color, float2 tc)
{
	// Noise
	float db_noise = SSFX_permute(SSFX_permute(SSFX_permute(tc.x) + tc.y) + noise(tc));

	// Get random direction [ -1 ~ 1 ]
	float2 dir = float2(cos(db_noise), sin(db_noise));

	[unroll (2)]
	for (int loop_cnt = 1; loop_cnt <= 2; loop_cnt++)
	{
		// More variaton for each iteration
		db_noise = SSFX_permute(db_noise);

		// Process image
		dband_process_fog(color, tc, db_noise * 0.0033f, dir, loop_cnt);
	}

	// Return result
	return color;
}


float4 main(p_screen I) : SV_Target
{
	// Sample buffers
#ifndef USE_MSAA
	float4 Pos = s_position.Sample( smp_nofilter, I.tc0 );
#else
	float4 Pos = s_position.Load( int3( I.hpos.xy, 0 ), 0 );
#endif

	float3 P = float3( Pos.z * ( I.hpos.xy * pos_decompression_params.zw - pos_decompression_params.xy ), Pos.z );

	// Calc fog ( Vanilla + Height fog )
	float fogresult = SSFX_CALC_FOG(P);
	fogresult *= fogresult;

	// Scene & Blurred Scene
	float3 blur = ssfx_debanding_fog(s_blur_2.Sample(smp_linear, I.tc0).rgb, I.tc0);
	float3 img = s_image.Sample(smp_nofilter, I.tc0);

	// Use color difference to adjust the blur weight. ( To avoid light leaking to fog )
	float Delta = dot(blur, img);
	fogresult *= Delta * Delta;

	// Mix Scene with Blur
	float3 fog_scattering = lerp(img, max(img, blur), smoothstep(0.1f, 1.0f - (ssfx_scattering_setup.x * 0.8), fogresult));

	return float4(fog_scattering, 1);
}