#include "common.h"

Texture2D s_vp2;
uniform float4 scope_lens_state;
uniform float4 scope_lens_glass;
uniform float4 scope_lens_size;
uniform float4 scope_lens_targets[8];

struct p_scope_lens {
    float2 tc : TEXCOORD0;
    float3 view_pos : TEXCOORD1;
    float3 view_tangent : TEXCOORD2;
    float3 view_binormal : TEXCOORD3;
    float3 view_normal : TEXCOORD4;
};

float4 main(p_scope_lens I, float4 pos2d : SV_Position) : SV_Target
{
    float4 reticle = s_base.Sample(smp_base, I.tc);
    float active = saturate(scope_lens_state.x);
    if (active < 0.5f)
        return reticle;

    // SV_Position addresses the lens pixel in the full-screen world pass.
    float2 tc = saturate(pos2d.xy / scope_lens_size.xy);
    float3 scene = s_vp2.Sample(smp_rtlinear, tc).rgb;

    // The 3DSS config dims older optics to (0.8, 0.8, 0.76). Keep most of
    // that absorption near the rim so the center stays readable. Lens UVs
    // follow the HUD mesh, while the world image still uses SV_Position.
    if (scope_lens_state.y < 0.5f)
    {
        float2 lens_uv = I.tc * 2.0f - 1.0f;
        float rim = smoothstep(0.25f, 0.95f, dot(lens_uv, lens_uv));
        scene *= lerp(float3(0.99f, 0.99f, 0.98f),
                      float3(0.80f, 0.80f, 0.76f), rim);

        float3 eye = normalize(-I.view_pos);
        float3 normal = normalize(I.view_normal);
        float facing = max(abs(dot(eye, normal)), 0.2f);
        float2 eye_offset = float2(dot(eye, normalize(I.view_tangent)),
                                   dot(eye, normalize(I.view_binormal))) / facing;
        float pupil = length(lens_uv + eye_offset * scope_lens_glass.x);
        float pupil_shadow = smoothstep(0.55f, 1.0f, pupil);
        scene *= 1.0f - pupil_shadow * scope_lens_glass.z;

        // Move a weak broad reflection with the viewing angle.
        float2 glint_uv = (I.tc - float2(0.29f, 0.23f) - eye_offset * 0.04f)
                          * float2(1.0f, 1.4f);
        float glint = exp2(-22.0f * dot(glint_uv, glint_uv));
        scene = saturate(scene + scope_lens_glass.y * glint * (1.0f - rim));
    }
    float3 image = lerp(scene, reticle.rgb, reticle.a);
    // The 2D optic's PPE is applied to the final screen. Keep optic modes inside
    // the physical lens instead of changing the player's entire field of view.
    // Apply them after the reticle blend: an opaque reticle texture must not
    // conceal the effect on the view through the lens.
    if (scope_lens_state.y > 1.5f)
    {
        float luma = dot(image, float3(0.299f, 0.587f, 0.114f));
        image = saturate(float3(0.08f, 1.0f, 0.13f) * pow(saturate(luma * 2.2f), 0.75f));
    }
    else if (scope_lens_state.y > 0.5f)
    {
        float luma = dot(image, float3(0.299f, 0.587f, 0.114f));
        // The legacy contrast.ppe also gives the 2D optic its yellow/olive
        // palette. Keep that palette confined to the physical 3D lens.
        float contrast = saturate(luma * 1.55f - 0.12f);
        image = contrast * float3(1.0f, 0.96f, 0.20f);
    }
    // Detector frames are projected with the lens camera and are only visible
    // through this material. The rest of the HUD never receives these pixels.
    if (scope_lens_state.z > 0.5f)
    {
        [unroll] for (int i = 0; i < 8; ++i)
        {
            float4 box = scope_lens_targets[i];
            if (box.z <= box.x || box.w <= box.y)
                continue;
            float2 edge = float2(2.0f, 2.0f) / scope_lens_size.xy;
            float2 corner = float2(11.0f, 11.0f) / scope_lens_size.xy;
            bool inside = all(tc >= box.xy) && all(tc <= box.zw);
            bool vertical = (abs(tc.x - box.x) < edge.x || abs(tc.x - box.z) < edge.x) &&
                (tc.y < box.y + corner.y || tc.y > box.w - corner.y);
            bool horizontal = (abs(tc.y - box.y) < edge.y || abs(tc.y - box.w) < edge.y) &&
                (tc.x < box.x + corner.x || tc.x > box.z - corner.x);
            if (inside && (vertical || horizontal))
                image = float3(0.65f, 0.9f, 0.65f);
        }
    }
    return float4(image, active);
}
