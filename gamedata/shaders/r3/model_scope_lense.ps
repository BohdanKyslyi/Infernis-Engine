#include "common.h"

Texture2D s_vp2;
uniform float4 scope_lens_state;
uniform float4 scope_lens_size;

struct p_scope_lens {
    float2 tc : TEXCOORD0;
};

float4 main(p_scope_lens I, float4 pos2d : SV_Position) : SV_Target
{
    float4 reticle = s_base.Sample(smp_base, I.tc);
    float active = saturate(scope_lens_state.x);
    if (active < 0.5f)
        return reticle;

    // SV_Position addresses the lens pixel in the full-screen world pass.
    float2 tc = saturate(pos2d.xy / scope_lens_size.xy);
    float3 scene = s_vp2.Sample(smp_rtlinear, tc).rgb;
    float3 image = lerp(scene, reticle.rgb, reticle.a);
    return float4(image, active);
}
