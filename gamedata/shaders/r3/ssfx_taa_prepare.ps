#include "common.h"

Texture2D s_ssfx_taa;
Texture2D s_motion_vectors;

float4 main(p_screen I) : SV_Target
{
	
#ifndef USE_MSAA
	float4 Pos = s_position.Sample( smp_linear, I.tc0.xy );
#else
	float4 Pos = s_position.Load( int3( I.hpos.xy, 0 ), 0 );
#endif

	float4 MV = s_motion_vectors.Sample(smp_linear, I.tc0.xy);

	Pos.z = Pos.z < 0.01f ? 1000000 : Pos.z;

	float mv_acc = lerp(length(MV.xy), s_ssfx_taa.Sample(smp_linear, I.tc0.xy).a, 0.5f );

	return float4(MV.xy, Pos.z, mv_acc);
	// ------------------------------------
}