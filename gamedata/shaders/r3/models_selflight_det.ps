#include "common.h"

#include "check_screenspace.h"
#include "screenspace_mvectors.h"

#ifdef SSFX_RAINDROPS
	#include "screenspace_hud_raindrops.h"
#endif

f_deffer main( p_flat I )
{
  f_deffer	O;

	// HUD Rain drops - SSS Update 17
	// https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders/

	//float4 result = 0; // xy = Normal | z = Overall str | w = reflection str
	float extra_col = 0;
	
#ifdef SSFX_RAINDROPS
	if (ssfx_hud_drops_1.y > 0)
	{
		// Calc droplets
		float4 Layer0 = s_hud_rain.Sample(smp_base, (I.tcdh.xy + float2(0, -ssfx_hud_drops_1.x * 0.01f))); // Big drops
		float4 Layer1 = s_hud_rain.Sample(smp_base, I.tcdh.xy * 1.5); // Small drops [ Static ]

		// Process animation
		float3 result = ssfx_process_drops(Layer0, 0.1f, 0.2f) + ssfx_process_drops(Layer1, 0.2f, 1.0f);
		result.xy = clamp(result.xy, -1.0f, 1.0f);

		// Only apply to facing up surfaces [ World Y+ ]
		result.xyz *= saturate(I.RDrops.y);

		// Intensity from script ( Cover + Rain intensity )
		result.xyz *= ssfx_hud_drops_1.y;

		// Refraction
		I.tcdh.xy = I.tcdh.xy - result.xy * 10;

		// Add a small amount of white.
		extra_col = saturate(Layer0.x + Layer1.x) * result.z * 5;
	}
#endif


  // diffuse
  float3 D	= s_base.Sample(smp_base, I.tcdh) + extra_col;	// IN:  rgb.a

	O = pack_gbuffer( 0, 0, float4( D.rgb, 0 ));

	// Motion vectors
	O.velocity = ssfx_mv_calc(I.vel_curr, I.vel_prev, 1, 0);

	return O;
}
