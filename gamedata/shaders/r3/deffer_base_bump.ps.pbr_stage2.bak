#include "common.h"
#include "sload.h"

f_deffer main(p_bumped I)
{
    f_deffer O;

    surface_bumped S = sload(I);

#ifdef USE_PBR
    float surface_height = 0.0f;
#else
    float surface_height = S.height;
#endif

    // Sample normal, rotate it by matrix, encode position
    float3 Ne = mul(
        float3x3(I.M1, I.M2, I.M3),
        S.normal
    );

    Ne = normalize(Ne);

    // hemi, sun, material
    float ms = xmaterial;

#ifdef USE_LM_HEMI

    float4 lm = s_hemi.Sample(
        smp_rtlinear,
        I.lmh
    );

    float h = get_hemi(lm);

#ifdef USE_R2_STATIC_SUN
    ms = get_sun(lm);
#endif

#else

    float h = I.position.w;

#ifdef USE_R2_STATIC_SUN
    ms = I.tcdh.w;
#endif

#endif // USE_LM_HEMI


    // =========================================================
    // Infernis Engine PBR G-buffer data
    // =========================================================

#ifdef USE_PBR

// =========================================================
// TEMP: neutral dielectric material test
// =========================================================

// Ignore texture AO for one test.
float gbuffer_hemi =
    saturate(h);

// Force NON-metal.
float gbuffer_material =
    gbuf_pack_pbr(
        gbuffer_hemi,
        0.0f
    );

// Force fairly rough surface.
float gbuffer_surface =
    0.70f;

#else

    // Original X-Ray values.
    float gbuffer_hemi =
        h;

    float gbuffer_material =
        ms;

    float gbuffer_surface =
        S.gloss;

#endif


    O = pack_gbuffer(
        float4(
            Ne,
            gbuffer_hemi
        ),

        float4(
            I.position.xyz +
            Ne * surface_height * def_virtualh,

            gbuffer_material
        ),

        float4(
            S.base.xyz,
            gbuffer_surface
        )
    );

    return O;
}