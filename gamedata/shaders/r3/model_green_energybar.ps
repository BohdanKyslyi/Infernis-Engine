#include "common.h"
#include "gs_weapon_computer.h"

float4 main(float2 uv : TEXCOORD0) : SV_Target
{
    float4 texel = s_base.Sample(smp_base, uv);
    float charge = saturate(weapon_computer_display.x);
    texel.a *= step(uv.x, charge) * step(0.001, charge);
    texel.rgb += float3(0.5, -0.5, 0.0) * (1.0 - step(0.1, charge));
    texel.rgb = saturate(texel.rgb + weapon_computer_noise(uv));
    return texel;
}
