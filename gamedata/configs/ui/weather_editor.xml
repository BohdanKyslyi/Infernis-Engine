<w>
    <!-- Transparent editor: there is intentionally no full-panel background. -->
    <main x="20" y="20" width="984" height="708">
        <title x="0" y="0" width="984" height="26">
            <text font="graffiti22" r="225" g="225" b="225" align="c">ui_weather_editor_title</text>
        </title>

        <auto_static x="8" y="34" width="66" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_weather</text>
        </auto_static>
        <weather x="76" y="32" width="234" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </weather>

        <auto_static x="336" y="34" width="70" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_keyframe</text>
        </auto_static>
        <frame x="408" y="32" width="230" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </frame>

        <auto_static x="664" y="34" width="68" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_sky</text>
        </auto_static>
        <sky x="734" y="32" width="242" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </sky>

        <auto_static x="8" y="61" width="66" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_clouds</text>
        </auto_static>
        <clouds x="76" y="59" width="234" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </clouds>

        <auto_static x="336" y="61" width="70" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_ambient</text>
        </auto_static>
        <ambient_definition x="408" y="59" width="230" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </ambient_definition>

        <auto_static x="664" y="61" width="68" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_sun</text>
        </auto_static>
        <sun_definition x="734" y="59" width="242" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </sun_definition>

        <auto_static x="8" y="88" width="108" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_thunderbolt_selector</text>
        </auto_static>
        <thunderbolt_definition x="118" y="86" width="192" height="18" list_length="8" always_show_scroll="1">
            <list_font r="205" g="205" b="205" font="letterica16"/>
            <text_color><e r="220" g="220" b="220"/><d r="80" g="80" b="80"/></text_color>
        </thunderbolt_definition>

        <auto_static x="336" y="88" width="104" height="18">
            <text font="letterica16" r="180" g="180" b="180">ui_weather_editor_new_weather</text>
        </auto_static>
        <new_weather_name x="442" y="85" width="330" height="21" max_symb_count="63" file_name_mode="1">
            <text font="letterica16" r="220" g="220" b="220" vert_align="c"/>
        </new_weather_name>
        <create_weather x="782" y="82" width="194" height="25" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica16" align="c">ui_weather_editor_create_weather</text>
            <text_color><e r="185" g="220" b="175"/></text_color>
        </create_weather>

        <auto_static x="8" y="116" width="46" height="18">
            <text font="letterica16" r="190" g="190" b="190">ui_weather_editor_time</text>
        </auto_static>
        <time_slider x="54" y="116" width="602" height="12" step="60"/>
        <time_value x="666" y="112" width="82" height="20">
            <text font="letterica16" r="225" g="225" b="225" align="c" vert_align="c">00:00:00</text>
        </time_value>
        <add_frame x="758" y="108" width="104" height="25" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica16" align="c">ui_weather_editor_add_section</text>
            <text_color><e r="185" g="220" b="175"/></text_color>
        </add_frame>
        <preview x="872" y="108" width="104" height="25" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica16" align="c">ui_weather_editor_preview</text>
            <text_color><e r="190" g="205" b="220"/></text_color>
        </preview>

        <!-- C++ clones these templates for all 36 numeric values. -->
        <property_header_template x="0" y="0" width="310" height="18">
            <text font="letterica16" r="210" g="220" b="210">ui_weather_editor_section</text>
        </property_header_template>
        <property_label_template x="0" y="0" width="100" height="17">
            <text font="letterica16" r="185" g="185" b="185" vert_align="c">ui_weather_editor_value</text>
        </property_label_template>
        <property_slider_template x="0" y="0" width="142" height="12" step="0.01"/>
        <property_value_template x="0" y="0" width="55" height="17">
            <text font="letterica16" r="220" g="220" b="220" align="r" vert_align="c">0.000</text>
        </property_value_template>

        <status x="8" y="548" width="968" height="34">
            <text font="letterica16" r="195" g="210" b="195" align="c" vert_align="c" complex_mode="1"/>
        </status>

        <save x="200" y="604" width="180" height="28" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica18" align="c">ui_weather_editor_save</text>
            <text_color><e r="190" g="220" b="170"/></text_color>
        </save>
        <revert x="402" y="604" width="180" height="28" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica18" align="c">ui_weather_editor_revert</text>
            <text_color><e r="220" g="200" b="150"/></text_color>
        </revert>
        <close x="604" y="604" width="180" height="28" stretch="1">
            <texture>ui_inGame2_Mp_bigbuttone</texture>
            <text font="letterica18" align="c">ui_weather_editor_close</text>
            <text_color><e r="205" g="205" b="205"/></text_color>
        </close>

        <auto_static x="8" y="654" width="968" height="20">
            <text font="letterica16" r="135" g="135" b="135" align="c">ui_weather_editor_footer</text>
        </auto_static>
    </main>
</w>
