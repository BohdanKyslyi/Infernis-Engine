; =======================================================
; Noir Engine Modular Inventory Slots
; Read only when [inventory] enable_modular_slots = true
; in noirEngineExtention.ltx.
; =======================================================

[slots]
binocular_slot	= false	; false = original persistent binocular behaviour
torch_slot		= false	; false = original persistent flashlight behaviour
knife_slot		= false	; false = original persistent knife behaviour
pistol_slot		= false	; false = disable the optional third weapon slot
backpack_slot	= false	; false = disable backpack slot
