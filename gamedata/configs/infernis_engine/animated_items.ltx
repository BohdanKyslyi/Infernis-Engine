[consumable]:booster
eat_portions_num = 1
visual				= dynamics\fake_object.ogf

[animated_item]:identity_immunities
hud							= animated_item_hud

sprint_allowed					= false

;звуки
snd_using   = $silent

[animated_item_hud]:hud_base
attach_place_idx				= 0
item_visual				= dynamics\fake_object.ogf

hands_position 				= 0,0,0
hands_position_16x9			= 0,0,0
hands_orientation			= 0,0,0
hands_orientation_16x9		= 0,0,0

item_position				= 0,0,0
item_orientation			= 0,0,0

aim_hud_offset_pos			= 0.0,0.0,0.0
aim_hud_offset_rot			= 0.0,0.0,0.0

aim_hud_offset_pos_16x9		= 0.0,0.0,0.0
aim_hud_offset_rot_16x9		= 0.0,0.0,0.0

viewport_near = 0.05

[base_trash]
GroupControlSection = spawn_group
$spawn        = "physics\base_trash"
$prefetch       = 8
class       = O_PHYS_S

; CPHSkeleton
remove_time = 5

; IMPORTANT:
; create physics shell already active
active = true

; Infernis Engine lifetime
timing_trash = 30000

[device_pda_hud]:animated_item_hud
item_visual      = dynamics\devices\dev_pda\dev_pda_hud.ogf

