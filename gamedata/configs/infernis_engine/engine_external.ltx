; ======================================================================
; Infernis Engine & Noir Engine Global Extensions Configuration
; ======================================================================

; Extended weather and environmental effects
[environment]
enable_rain_material_sounds	= false	; Enables dynamic rain-on-material impact sounds (true = on / false = off)
enable_dynamic_rain_wind	= true	; Controls raindrop tilt and fall-speed response based on wind intensity defined in the weather system
enable_custom_lightning		= true	;Renders lightning strikes around the player based on distance tiers and probability weights

;Extended UI parameters
[ui_extensions]
show_dialog_portraits = false		; true - показувати бокові панелі в діалогах, false - приховати
enable_tactical_compass = true		; horizontal heading strip in the single-player HUD

; =======================================================
; Noir Engine Modular Inventory Slots
; Read only when [slots] enable_modular_slots = true
; =======================================================

[slots]
enable_modular_slots	= true				; true = read independent slot switches
binocular_slot			= false				; false = original persistent binocular behaviour
torch_slot				= false				; false = original persistent flashlight behaviour
knife_slot				= false				; false = original persistent knife behaviour
pistol_slot				= false				; false = disable the optional third weapon slot
backpack_slot			= true				; false = disable backpack slot

;Infernis Engine extended HUD parameters
[hud_extensions]
viewport_near			= 0.2f				; 0.05f - для юзу сучасних збройових паків, 0.2f - для ванільних
hands_animations_path	= hands_animations\*.omf
enable_actor_legs		= true				; Enables a synchronized first-person legs model from actor HUD sections

; =======================================================
; Infernis Engine Items Animations Controller parameters
; Used for cutscenes and gameplay features
; =======================================================

[items_animations]
enable_consumables_animations			= true ; анімації використання предметів
enable_backpack_animations				= true ; анімації рюкзаків
enable_pda_animations					= true ; анімації ПДА
enable_dressing_animations				= true ; анімації вдягання броні / шоломів / рюкзаків
enable_mutant_looting_animations		= true ; анімації зрізання частин тіл мутантів
enable_mutant_looting_particles			= true ; ефекти партиклів під час зрізання частин тіл мутантів
mutant_looting_particle_timing			= 1300
backpack_hud							= backpack_stalker_hud
pda_hud               					= device_pda_hud
outfit_dressing_hud						= outfit_animation_hud
helmet_dressing_hud						= helm_respirator_hud
backpack_dressing_hud					= outfit_animation_hud
mutant_looting_hud						= mutant_looting_hud

; =======================================================
; Discord Rich Presence
; Use Discord Developers Portal for more information
; =======================================================

[discord_rpc]
enable				= true
application_id		= 1542134331114397736

show_playtime		= true
show_location		= true
show_renderer		= true
show_task			= true
show_task_name		= true

large_image			= infernis
large_image_text	= Infernis Engine

renderer_dx9_image 	= renderer_dx9
renderer_dx10_image	= renderer_dx10
renderer_dx11_image	= renderer_dx11

; =======================================================
; Infernis Engine extended Shader configuration
; Parameters for PBR and other shader extensions
; =======================================================

[shader_extensions]
enable_pbr_rendering	= false ; увімкнення PBR-рендерингу
sslr_mode				= off ; performance / balanced / quality / reference / off
allow_bloodmarks_on_npc	= true; відображення кривавих слідів у сталкерів і мутантів

; R4 draws the world a second time for optics with scope_3d and scope_lens_fov.
; The existing 2D overlay is used if this switch is disabled.
[weapon_scopes]
enable_3d_scopes		= false
; Fraction of screen width/height included in second-view visibility queries (0.5-1.0).
; 1.0 renders the whole world view; 0.8 saves scene traversal outside the lens.
; Increase this if a very large or off-centre lens clips world objects.
scope_world_cull_scale	= 0.8
; performance = after aiming finishes, balanced = when aiming begins,
; quality = from the moment an equipped scoped weapon becomes active.
scope_render_mode		= balanced
; Red/blue separation in screen pixels near the lens rim (0 = off, 0.0-3.0).
scope_lens_chromatic_aberration = 0.8
