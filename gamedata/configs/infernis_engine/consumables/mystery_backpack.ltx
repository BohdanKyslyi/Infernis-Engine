[mystery_backpack]:booster
$spawn 				= "food and drugs\mystery_backpack"
visual				= dynamics\devices\dev_rukzak\dev_rukzak.ogf

inv_name			= st_mystery_backpack
inv_name_short		= st_mystery_backpack
description			= st_mystery_backpack_descr

icons_texture					= ui\ui_icon_backpacks_iba
inv_grid_width     				= 2
inv_grid_height    				= 3
inv_grid_x         				= 0
inv_grid_y         				= 0

inv_weight			= 1.0 ; Вага предмету
cost				= 1000; Вартість (у гривнях)

next_section = backpack_stalker ; Секція, яку ГГ гарантовано отримає розпакувавши цей предмет
next_section_2 = medkit, 2 ; Декілька секцій одного виду, які ГГ гарантовано отримає розпакувавши цей предмет

next_random   = mystery_backpack_food ; Набір секцій, з яких ГГ рандомно отримає якийсь предмет
next_random_2 = mystery_backpack_detectors
next_random_3 = mystery_backpack_helmets
next_random_4 = mystery_backpack_weapons

[mystery_backpack_food]
option = bandage, 5, medkit, 3, conserva, 2
option_2 = medkit, 5, vodka, 3, kolbasa, 2
option_3 = antirad, 3, medkit, 2, bandage, 1, kolbasa, 2, conserva, 1
	
