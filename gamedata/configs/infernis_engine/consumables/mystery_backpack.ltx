option_4 = wpn_abakan, 1, ammo_5.45x39_ap, 2
option_5 = wpn_sig550, 1, ammo_5.56x45_ap, 2
option_6 = wpn_ak74, 1, ammo_5.45x39_fmj, 2
option_7 = wpn_l85, 1, ammo_5.56x45_ss190, 2