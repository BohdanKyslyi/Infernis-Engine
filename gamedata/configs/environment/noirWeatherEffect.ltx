[custom_lightning]
; =======================================================
; --- БАГАТОКРАТНІ УДАРИ (MULTI-STRIKES) ---
; =======================================================
enable_multi_strikes   = true     ; Головний вимикач системи багатократних блискавок (true/false)
multi_strike_chance    = 3        ; Вірогідність (у %), що вдарить не одна блискавка, а кілька одночасно
max_simultaneous       = 3        ; Максимальна кількість блискавок у залпі (наприклад, від 2 до 3)

; Наступні два параметри працюють ТІЛЬКИ якщо спрацював multi_strike_chance:
same_location_chance   = 5        ; Вірогідність (у %), що додаткові блискавки візьмуть координати першої (хмару).
branching_chance       = 20       ; Вірогідність (у %), що блискавки з однієї хмари розійдуться ГІЛКАМИ в різні точки землі. Якщо не спрацює - буде ефект СТРОБОСКОПА (удар в одну точку).

; =======================================================
; --- ВІЗУАЛ БЛИСКАВКИ ---
; =======================================================
height_factor          = 0.85     ; Оптимальна висота зародження блискавки (множник від дальності видимості)
size_multiplier        = 2.5      ; Товщина та агресивність гілок блискавки

; =======================================================
; --- БАЛАНС ЙМОВІРНОСТЕЙ ДИСТАНЦІЇ ---
; =======================================================
prob_near              = 3        ; Тільки 3% шансу, що вдарить поруч
prob_medium            = 17       ; 17% середньої дистанції
; Решта 80% йде на далекі удари для створення густого фонового ембієнту

; --- ДИСТАНЦІЇ (в метрах) ---
dist_near_min          = 5.0
dist_near_max          = 35.0     ; Мінімальна зона

dist_medium_min        = 35.0
dist_medium_max        = 300.0    ; Середня зона

dist_far_min           = 300.0
dist_far_max           = 500.0    ; Максимальна зона

; =======================================================
; --- ЕФЕКТИ ВЛУЧАННЯ (Партикли) ---
; =======================================================
strike_particle        = anomaly2\electra2_blast ; Партикл
;strike_sound          = anomaly\electra_hit ; Звук влучання в поверхню

; =======================================================
; --- ПАРАМЕТРИ ФІЗИКИ ЗВУКУ (Синхронізовані з візуалом) ---
; =======================================================
thunder_range_min      = 120.0    ; Дистанція, з якої починається спотворення звуку грому
thunder_range_max      = 1000.0   ; Ліміт для OpenAL (щоб рушій не обрізав звук завчасно)

; Тепер блискавка на межі видимості (400м) отримає 100% басу і приглушення:
thunder_fade_dist      = 300.0    ; Дистанція повного загасання високих частот (відлік іде ВІД thunder_range_min)

thunder_pitch_drop     = 0.80     ; Соковитий бас на великій відстані (чим ближче до 1.0, тим нижчий звук)
thunder_vol_drop       = 0.55     ; Приглушення гучності далекого грому (чим ближче до 1.0, тим тихіше)

; ЗВУК УДАРУ ОБ ЗЕМЛЮ (Тріск)
strike_snd_range_min   = 8.0      ; Пікова гучність тріску прямо перед носом
strike_snd_range_max   = 35.0     ; Ідеально збігається з dist_near_max! Далі 35 метрів звук розриву землі зникає.

; СМЕРТОНОСНІСТЬ БЛИСКАВКИ (AOE - Area of Effect)
strike_damage_power    = 2.5      ; Сила удару (2.5 вб'є практично будь-кого в епіцентрі)
strike_damage_radius   = 20.0     ; Радіус ураження (в метрах). Далі від центру - менший урон.

[dynamic_wind]
; =======================================================
; --- ДИНАМІЧНИЙ ВІТЕР (Вплив на краплі дощу) ---
; =======================================================
max_angle             = 60.0     ; Максимальний кут нахилу крапель дощу під час шторму (у градусах)
speed_wind_multiplier = 1.5      ; Множник прискорення падіння крапель від сили вітру

[rainmaterial]
; =======================================================
; --- МАТЕРІАЛИ ТА ЗВУКИ ДОЩУ ---
; =======================================================
; Налаштування звуків ударів крапель об різні поверхні.
; Формат: ім'я_матеріалу = шлях_до_звуку
metal                 = nature\rain_tin_1_medium
wood                  = nature\rain_wooden_roof_medium_st_loop
wooden_board          = nature\rain_wooden_roof_medium_st_loop
tree_trunk            = nature\rain_wooden_roof_medium_st_loop
grass                 = nature\rain_ground_light_stereo_loop
earth                 = nature\rain_ground_light_stereo_loop
earth_death           = nature\rain_ground_light_stereo_loop
earth_slide           = nature\rain_ground_light_stereo_loop
sand                  = nature\rain_ground_light_stereo_loop
tin                   = nature\rain_tin_1_medium
shifer                = nature\rain_tin_1_medium
asphalt               = nature\rain_heavy_2_loop

[rain_audio]
; =======================================================
; --- ГЛОБАЛЬНА АУДІОСИСТЕМА ДОЩУ (2.5D Portals) ---
; =======================================================
; УВАГА ДЛЯ МОДМЕЙКЕРІВ: 
; sound_2d має бути у СТЕРЕО (грає глобально).
; sound_portal ОБОВ'ЯЗКОВО має бути у МОНО (для коректного 3D-позиціонування у дверях/вікнах).
sound_2d              = ambient\rain_stereo
sound_portal          = ambient\rain_mono