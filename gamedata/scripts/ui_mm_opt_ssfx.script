-- A caption of two or three lines needs a taller row.
local template = { "ssfx:templ_item", "ssfx:templ_item_2", "ssfx:templ_item_3" }

class "opt_ssfx" (CUIWindow)

function opt_ssfx:__init() super()
end

function opt_ssfx:__finalize()
end

function opt_ssfx:InitControls(x, y, xml, handler)
	self:SetWndPos(vector2():set(x, y))
	self:SetWndSize(vector2():set(738, 416))
	self:SetAutoDelete(true)

	self.scroll_v = xml:InitScrollView("ssfx:scroll_v", self)

	for i = 1, #rows do
		local kind, name = rows[i][1], rows[i][2]
		local st = xml:InitStatic(template[rows[i][3]], self.scroll_v)
		xml:InitStatic("ssfx:cap_" .. name, st)
		if kind == "t" then
			xml:InitTrackBar("ssfx:track_" .. name, st)
		elseif kind == "l" then
			xml:InitComboBox("ssfx:list_" .. name, st)
		elseif kind == "c" then
			xml:InitCheck("ssfx:check_" .. name, st)
		end
	end

	local btn
	btn = xml:Init3tButton("ssfx:btn_basic", self)
	handler:Register(btn, "btn_ssfx_basic")
	btn = xml:Init3tButton("ssfx:btn_reset", self)
	handler:Register(btn, "btn_ssfx_reset")
end
