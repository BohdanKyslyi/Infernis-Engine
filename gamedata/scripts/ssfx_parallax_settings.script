-- If you're not using MCM you can customize your settings here --

-- Infernis: refine is the author's MCM default ( ssfx_parallax_mcm.script, false ) and not the 0
-- this file shipped with. Lua takes any number for true, so the 0 switched the refinement ON
-- ( ssfx_parallax.script tests it with "and 1 or 0" ) - which the defaults button of the native
-- settings page never does. This table is what a new profile runs on until that page is applied.

ssfx_default_settings =
{
	["quality"]			= 16.0,
	["refine"]			= false,

	["range"]			= 12,
	["height"]			= 0.035,
	["ao"]				= 0.4,
}

