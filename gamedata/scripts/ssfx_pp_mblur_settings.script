-- If you're not using MCM you can customize your settings here --

-- Infernis: hudonly is the author's MCM default ( ssfx_pp_mcm.script, false ) and not the 0.0
-- this file shipped with. Lua takes any number for true, so the 0.0 switched "HUD only" ON
-- ( ssfx_pp_mblur.script tests it with "and 1 or 0" ) - which the defaults button of the native
-- settings page never does. This table is what a new profile runs on until that page is applied.

ssfx_default_settings =
{
	["quality"]			= 6.0,

	["intensity"]		= 1.0,
	["camera"]			= 1.0,

	["hudonly"]			= false,
}

