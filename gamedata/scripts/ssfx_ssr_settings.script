-- @ Version: SCREEN SPACE SHADERS - UPDATE 17
-- @ Description: Rain script - Settings
-- @ Author: https://www.moddb.com/members/ascii1457
-- @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders

-- If you're not using MCM you can customize your settings here --

-- Infernis: four values below are the author's MCM defaults ( ssfx_ssr_mcm.script ) and not the
-- ones this file shipped with, which were render_scale 0.5, blur 0.0, use_noise 0.0 and
-- weapon_int 1.0. The native settings page stands where MCM stood and its defaults button gives
-- the MCM values, while this table is what a new profile runs on until that page is applied, so
-- the two have to agree. use_noise was a number besides, and Lua takes any number for true: the
-- 0.0 switched the noise ON ( ssfx_ssr.script tests it with "and 1 or 0" ).

ssfx_default_settings =
{
	["quality"]			= 0,

	["render_scale"]	= 1.0,
	["blur"]			= 0.2,
	["temporal"]		= 0.6,
	["use_noise"]		= false,


	["general_int"]		= 1.0,
	["sky_int"]			= 1.0,
	["weapon_int"]		= 0.5,
	["weapon_int_max"]	= 0.02,

}

