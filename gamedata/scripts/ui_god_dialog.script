--[[-----------------
Головний скрипт Infernis Core Spawner, створений на основі моду «Повелитель Зони» за авторством Shoker та stalker-MiX
--]]-----------------

local mode 

class "god_item" (CUIListBoxItem)

function god_item:__init(height) super(height)
	printf("%f",height)
	self.file_name		= "filename"

		self:SetTextColor(GetARGB(255, 170, 170, 170))

		self.fn = self:GetTextItem()
		self.fn:SetFont(GetFontLetterica18Russian())
		self.fn:SetEllipsis(true)
end

function god_item:__finalize()
end

class "god_dialog" (CUIScriptWnd)

function god_dialog:__init() super()
	 self:InitControls()
	 self:InitCallBacks()
end

function god_dialog:__finalize()
end

local function inventory_catalog_api()
    local api = rawget(_G, "infernis_spawner")
    if type(api) ~= "table" or type(api.get_catalog) ~= "function" or type(api.refresh) ~= "function" then
        error(game.translate_string("st_infernis_spawner_api_inventory"))
    end
    return api
end

local function runtime_api()
    local api = inventory_catalog_api()
    if type(api.get_option) ~= "function" or type(api.set_option) ~= "function"
        or type(api.set_weather) ~= "function" or type(api.teleport_to_object) ~= "function" then
        error(game.translate_string("st_infernis_spawner_api_runtime"))
    end
    return api
end

local function tools_api()
    local api = inventory_catalog_api()
    if type(api.actor_state) ~= "function" or type(api.get_bookmarks) ~= "function" then
        error(game.translate_string("st_infernis_spawner_api_tools"))
    end
    return api
end
local function cop_adapter()
    if not getFS():exist("$game_scripts$", "infernis_core_spawner.script") then return nil end
    local ok, adapter = pcall(function() return infernis_core_spawner end)
    if ok and type(adapter) == "table" and type(adapter.capabilities) == "function" then return adapter end
end
local bookmark_entries = {}
local function adapter_result(name, ...)
    local adapter = cop_adapter()
    if not adapter or type(adapter[name]) ~= "function" then return {ok=false,error=game.translate_string("st_infernis_spawner_adapter_missing")} end
    return adapter[name](...)
end

function god_dialog:ShowNativeResult(result)
    if result.ok then return true end
    self.message_box:InitMessageBox("message_box_error")
    self.message_box:SetText(result.error)
    self.message_box:ShowDialog(true)
    return false
end

function god_dialog:SaveOptions()
    if not tools_api().actor_state().ready then return end
    local api = runtime_api()
    local controls = {
        weather_state = self.chek_weather, immortal_show = self.chek_immortal,
        power_show = self.chek_power, bleeding_show = self.chek_bleeding,
        repair_show = self.chek_repair, ammunitions_show = self.chek_ammunitions,
        position_show = self.chek_position, info_show = self.chek_info,
        space_restrictor_show = self.chek_space_restrictor, distance_show = self.chek_distance
    }
    for name, control in pairs(controls) do
        if not self:ShowNativeResult(api.set_option(name, control:GetCheck())) then return false end
    end
    return true
end

function god_dialog:FillInventoryList(category)
    self.list_box:RemoveAll()
    mode = "item"
    for _, entry in ipairs(inventory_catalog_api().get_catalog(category)) do
        self:AddItemToList(game.translate_string(entry.name), entry.section)
    end
end

local native_entries = {}

local function world_api()
    local api = runtime_api()
    if type(api.get_world_catalog) ~= "function" or type(api.get_weather_catalog) ~= "function"
        or type(api.get_locations) ~= "function" or type(api.get_nearby_smarts) ~= "function"
        or type(api.spawn_world) ~= "function" or type(api.teleport) ~= "function" then
        error(game.translate_string("st_infernis_spawner_api_world"))
    end
    return api
end

function god_dialog:FillNativeList(category)
    self.list_box:RemoveAll()
    native_entries = {}
    local entries
    if category == "weather" then
        mode = "weather"
        entries = world_api().get_weather_catalog()
    elseif category == "level" then
        mode = "level"
        entries = world_api().get_locations(false, 0)
    else
        mode = "world"
        entries = world_api().get_world_catalog(category)
    end
    for _, entry in ipairs(entries) do
        local key = entry.section
        if category == "weather" then key = (entry.fx and "fx:" or "cycle:") .. entry.section end
        native_entries[key] = entry
        self:AddItemToList(entry.name, key)
    end
end

function god_dialog:FillList()
    -- Rebuild from loaded settings on every opening, including same-size config reloads.
    inventory_catalog_api().refresh()
    self:FillInventoryList("items")
end


