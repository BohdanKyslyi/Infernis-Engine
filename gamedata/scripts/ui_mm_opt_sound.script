class "opt_sound" (CUIWindow)

function opt_sound:__init() super()
end

function opt_sound:__finalize()

end

function opt_sound:InitControls(x, y, xml, handler)

	self:SetWndPos(vector2():set(x,y))
	self:SetWndSize(vector2():set(738,416))
	self:SetAutoDelete(true)

--	self.bk = xml:InitFrame("frame", self)

	xml:InitStatic("tab_sound:cap_mastervolume",		self)
	xml:InitStatic("tab_sound:cap_musicvolume",			self)

	xml:InitStatic("tab_sound:cap_check_eax",			self)
	xml:InitStatic("tab_sound:cap_check_dynamic_music",	self)

	xml:InitCheck("tab_sound:check_eax",				self)
    xml:InitStatic("tab_sound:cap_check_hrtf", self)
    self.check_hrtf = xml:InitCheck("tab_sound:check_hrtf", self)
    xml:InitStatic("tab_sound:cap_snd_output", self)
    self.list_output = xml:InitComboBox("tab_sound:list_snd_output", self)
    handler:Register(self.list_output, "sound_output")
    handler:AddCallback("sound_output", ui_events.LIST_ITEM_SELECT, self.OnOutputChanged, self)
    xml:InitStatic("tab_sound:audio_hint", self)
    self.audio_status = xml:InitStatic("tab_sound:audio_status", self)
	xml:InitCheck("tab_sound:check_dynamic_music",		self)


	xml:InitTrackBar				("tab_sound:track_musicvolume",	self)
	xml:InitTrackBar				("tab_sound:track_mastervolume",self)


	xml:InitStatic					("tab_sound:cap_snd_device",		self)
	xml:InitComboBox				("tab_sound:list_snd_device",	self)

end

function opt_sound:OnOutputChanged()
    -- Keep the headphone preference, but do not apply it to surround speakers.
    self.check_hrtf:Enable(self.list_output:CurrentID() < 2)
end

function opt_sound:RefreshStatus()
    self:OnOutputChanged()
    local status = get_console():get_string("snd_status") or ""
    self.audio_status:TextControl():SetText(status)
end
