-- @ Description: Infernis PBR - the factory values of its settings page

--[[
	A slider's value is the number shaders\r3\infernis_pbr_lighting.h ships with. The two
	switches are PBR on and SSLR as the game's engine_external.ltx has it. A drop-down list
	takes the NAME of its entry, which is how the console command of a list is written.

	OnBtnPBRReset in ui_mm_opt_main.script writes these to the console and then re-reads the
	page from it - the stock trackbar answers "set_default_value" with the middle of its
	range, which is not a default.

	Generated by _ssfx_work\pbr_page_build.py - run it again rather than editing here.
--]]

values = {
	{ "pbr_enable", "1" },
	{ "pbr_sslr_mode", "ui_pbr_sslr_off" },
	{ "pbr_sun_diffuse", "0.9" },
	{ "pbr_local_diffuse", "0.8" },
	{ "pbr_ambient_diffuse", "0.9" },
	{ "pbr_sun_specular", "1" },
	{ "pbr_local_specular", "1" },
	{ "pbr_ambient_specular", "1" },
	{ "pbr_sun_peak", "0.25" },
	{ "pbr_local_peak", "2" },
	{ "pbr_min_roughness", "0.08" },
	{ "pbr_aa_strength", "0.35" },
	{ "pbr_aa_variance", "0.1" },
	{ "pbr_metal_energy", "0.72" },
	{ "pbr_metal_roughness_gain", "2" },
}
