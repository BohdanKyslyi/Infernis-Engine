-- rows[ module ] = { { kind, key, label, description, restart, lines, command, factory,
--                      shown, own caption }, ... }
--   kind         "t" slider, "c" check box, "l" drop-down list, "r" the sun shafts mode
--                ( a list the window fills itself )
--   key          the control's node in ui_sss_menu.xml is "rows:t_" / "rows:k_" /
--                "rows:l_" / "rows:r_" .. key; the caption registers as "c_" .. key,
--                the control as "v_" .. key
--   label, description   string ids; a description the game has no text for is left
--                empty by the window
--   restart      the setting needs a restart of the game ( a * after the caption )
--   lines        lines of caption, which pick the row ( "tpl:row_" .. lines )
--   factory      what "Defaults" writes to the command
--   shown        sliders only: { a, b, reciprocal, decimals }. The number next to the
--                slider is a * V + b, or a / V + b, V being the console value: the
--                author's own unit. false where a row that is no slider needs the next
--                field
--   own caption  true: the caption is built from "rows:c_" .. key, a node narrower than
--                "tpl:cap_" .. lines, for a list that grows to the left over it
