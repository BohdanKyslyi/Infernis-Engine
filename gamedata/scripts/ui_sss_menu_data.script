-- The sun shafts mode: the console's token and the text the list shows for it, in the
-- engine's order ( xrRender_console.cpp, sunshafts_mode_token ). An entry's position is
-- its id in the list; ClearList leaves the list at 0, so the first pick always counts.
ray_command = "r2_sunshafts_mode"
ray_mode = {
	{ "off", "ui_sss_x_ray_mode_off" },
	{ "volumetric", "ui_sss_x_ray_mode_volumetric" },
	{ "screen_space", "ui_sss_x_ray_mode_screen_space" },
	{ "combined", "ui_sss_x_ray_mode_combined" },
}
