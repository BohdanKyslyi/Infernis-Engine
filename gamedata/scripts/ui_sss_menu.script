-- @ Description: Screen Space Shaders - the "SSS Settings" window
-- @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders

--[[
	The window the "SSS Settings" button of the video page opens ( OnBtnSSFX in
	ui_mm_opt_main.script ). It is laid out like Anomaly's MCM: the modules on the left, the
	settings of the module picked on the right, and under them what the setting clicked last
	does.

	Every slider, check box and list carries an options_item in ui_sss_menu.xml, so the engine's
	own COptionsManager reads the console and writes it back, exactly as on the game's own pages.
	Each module is an options group of its own ( mm_opt_sss_<module> ), so "Defaults" touches only
	the module on screen. Two things this file does itself: the number next to each slider, and
	the sun shafts mode, whose list it fills.

	The window opens and closes the way the main menu opens its load dialog: the options dialog
	steps aside while it is up and takes the screen back when it closes. "Apply" is the exception:
	it leaves for the main menu, as the options dialog's own "Apply" does.

	Generated by _ssfx_work\sss_menu_build.py together with ui_sss_menu.xml, ui_sss_menu_16.xml
	and ui_sss_menu_data.script - run it again rather than editing here.
--]]

local GROUP = "mm_opt_sss_"

class "sss_menu" (CUIScriptWnd)

function sss_menu:__init() super()
	self.ctl		= {}	-- [ key ] = { data, sel, cap, ctrl, num }
	self.page		= {}	-- [ module ] = the scroll view of its settings
	self.mark		= {}	-- [ module ] = the plate behind its line on the left
	self.btn		= {}	-- [ module ] = its line, a button
	self.title		= {}	-- [ module ] = the string id of its title
	self.first		= nil
	self.current	= nil
	self.selected	= nil
	self.kept		= nil	-- what the console held before "Defaults" wrote to it
	self.kept_cmd	= nil
	self.ray		= nil
	self.ray_choice	= nil
	-- while the window itself moves the controls ( opening, "Defaults" ), their messages only
	-- update the numbers
	self.loading	= true
	self:InitControls()
	self:InitCallBacks()
	self.loading	= false
end

function sss_menu:__finalize()
end

function sss_menu:InitControls()
	self:SetWndRect			(Frect():set(0, 0, 1024, 768))
	self:Enable				(true)

	local xml				= CScriptXmlInit()
	xml:ParseFile			("ui_sss_menu.xml")
	-- kept: the description is built again from its node each time another setting is picked
	self.xml				= xml

	xml:InitStatic			("background", self)
	self.form				= xml:InitStatic("form", self)
	xml:InitStatic			("form:caption", self.form)
	xml:InitFrame			("form:mod_frame", self.form)
	self.mod_list			= xml:InitScrollView("form:mod_list", self.form)
	xml:InitFrame			("form:page_frame", self.form)
	self.page_title			= xml:InitTextWnd("form:page_title", self.form)
	xml:InitFrame			("form:desc_frame", self.form)
	self.desc				= xml:InitScrollView("form:desc", self.form)
	xml:InitTextWnd			("form:legend", self.form)

	local btn
	btn = xml:Init3tButton	("form:btn_reset", self.form)
	self:Register			(btn, "btn_reset")
	btn = xml:Init3tButton	("form:btn_reset_all", self.form)
	self:Register			(btn, "btn_reset_all")
	btn = xml:Init3tButton	("form:btn_apply", self.form)
	self:Register			(btn, "btn_apply")
	btn = xml:Init3tButton	("form:btn_cancel", self.form)
	self:Register			(btn, "btn_cancel")

	for _, m in ipairs(ui_sss_menu_data.modules) do
		local id, kind, name, title, indent = m[1], m[2], m[3], m[4], m[5]
		local line = xml:InitStatic("tpl:mod_row", self.mod_list)
		if kind == "h" then
			xml:InitStatic("tpl:mod_head", line):TextControl():SetTextST(name)
		else
			local mark = xml:InitStatic("tpl:mod_sel", line)
			mark:Show(false)
			local b = xml:Init3tButton(indent > 0 and "tpl:mod_sub" or "tpl:mod_btn", line)
			b:TextControl():SetTextST(name)
			self:Register(b, "mod_" .. id)
			self.mark[id] = mark
			self.btn[id] = b
			self.title[id] = title
			if self.first == nil then
				self.first = id
			end
			self:BuildPage(xml, id)
		end
	end

	self:ShowText(game.translate_string("ui_sss_hint"))
end

-- One module's page: a row per setting, each holding the highlight, the caption, the control and,
-- for a slider, its number.
function sss_menu:BuildPage(xml, id)
	local page = xml:InitScrollView("form:page", self.form)
	page:Show(false)
	self.page[id] = page

	for _, r in ipairs(ui_sss_menu_data.rows[id]) do
		local kind, key, lines = r[1], r[2], r[6]
		local row = xml:InitStatic("tpl:row_" .. lines, page)
		local c = { data = r }
		c.sel = xml:InitStatic("tpl:sel_" .. lines, row)
		c.sel:Show(false)

		if r[10] then
			c.cap = xml:Init3tButton("rows:c_" .. key, row)
		else
			c.cap = xml:Init3tButton("tpl:cap_" .. lines, row)
		end
		local text = game.translate_string(r[3])
		if r[5] then
			text = text .. " *"
		end
		c.cap:TextControl():SetText(text)
		self:Register(c.cap, "c_" .. key)

		if kind == "t" then
			c.ctrl = xml:InitTrackBar("rows:t_" .. key, row)
			c.num = xml:InitTextWnd("tpl:num_" .. lines, row)
		elseif kind == "c" then
			c.ctrl = xml:InitCheck("rows:k_" .. key, row)
		elseif kind == "l" then
			c.ctrl = xml:InitComboBox("rows:l_" .. key, row)
		else
			c.ctrl = xml:InitComboBox("rows:r_" .. key, row)
			self.ray = c.ctrl
		end
		self:Register(c.ctrl, "v_" .. key)
		self.ctl[key] = c
	end
end

function sss_menu:InitCallBacks()
	self:AddCallback("btn_apply",	ui_events.BUTTON_CLICKED,	self.OnBtnApply,	self)
	self:AddCallback("btn_cancel",	ui_events.BUTTON_CLICKED,	self.OnBtnCancel,	self)
	self:AddCallback("btn_reset",	ui_events.BUTTON_CLICKED,	self.OnBtnReset,	self)
	self:AddCallback("btn_reset_all",	ui_events.BUTTON_CLICKED,	self.OnBtnResetAll,	self)

	for _, m in ipairs(ui_sss_menu_data.modules) do
		if m[2] == "m" then
			local id = m[1]
			self:AddCallback("mod_" .. id, ui_events.BUTTON_CLICKED, function() self:ShowModule(id) end, self)
			for _, r in ipairs(ui_sss_menu_data.rows[id]) do
				local kind, key = r[1], r[2]
				self:AddCallback("c_" .. key, ui_events.BUTTON_CLICKED, function() self:OnPick(key) end, self)
				if kind == "t" then
					self:AddCallback("v_" .. key, ui_events.BUTTON_CLICKED, function() self:OnTrack(key) end, self)
				elseif kind == "c" then
					self:AddCallback("v_" .. key, ui_events.BUTTON_CLICKED, function() self:OnPick(key) end, self)
				elseif kind == "l" then
					self:AddCallback("v_" .. key, ui_events.LIST_ITEM_SELECT, function() self:OnPick(key) end, self)
				else
					self:AddCallback("v_" .. key, ui_events.LIST_ITEM_SELECT, function() self:OnRayMode(key) end, self)
				end
			end
		end
	end
end

-- Opening, from OnBtnSSFX of the options dialog: every control reads the console, and what it
-- shows now is what "Cancel" goes back to.
function sss_menu:Open()
	self.loading = true
	local opt = COptionsManager()
	for _, m in ipairs(ui_sss_menu_data.modules) do
		if m[2] == "m" then
			opt:SetCurrentValues(GROUP .. m[1])
			opt:SaveBackupValues(GROUP .. m[1])
			self:UpdateNumbers(m[1])
		end
	end
	self.kept = nil
	self.kept_cmd = nil
	self.ray_choice = nil
	self:FillRayList(get_console():get_token(ui_sss_menu_data.ray_command))
	self.loading = false

	self:ShowModule(self.current or self.first)
	self:ShowDialog(true)
end

function sss_menu:Close()
	self.owner:ShowDialog(true)
	self:HideDialog()
	self.owner:Show(true)
end

-- "Apply" leaves for the main menu, as the options dialog's own "Apply" does ( OnApplyChanges ):
-- the options dialog stepped aside when this window opened ( OnBtnSSFX ), so the main menu is the
-- one to bring back. The same three calls as Close, the main menu in the owner's place.
function sss_menu:CloseToMain()
	local main = self.owner.owner
	main:ShowDialog(true)
	self:HideDialog()
	main:Show(true)
end

-- The line of the module on screen has the plate behind it and is switched off: a button takes its
-- text colour from its state on every frame ( UI3tButton.cpp, Update ), so the "disabled" colour
-- ( white, ui_sss_menu.xml ) is the one a script can keep. Clicking that line does nothing, which
-- is right: its page is already up.
function sss_menu:ShowModule(id)
	if self.current ~= nil then
		self.page[self.current]:Show(false)
		self.mark[self.current]:Show(false)
		self.btn[self.current]:Enable(true)
	end
	self.current = id
	self.page[id]:Show(true)
	self.page[id]:ScrollToBegin()
	self.mark[id]:Show(true)
	self.btn[id]:Enable(false)
	self.page_title:SetTextST(self.title[id])
	self:SelectRow(nil)
end

function sss_menu:SelectRow(key)
	if self.selected ~= nil then
		self.ctl[self.selected].sel:Show(false)
	end
	self.selected = key
	if key == nil then
		self:ShowText(game.translate_string("ui_sss_hint"))
		return
	end

	local c = self.ctl[key]
	c.sel:Show(true)
	-- the game gives back the id itself for an id it has no text for: then there is nothing to show
	local id = c.data[4]
	local text = game.translate_string(id)
	if text == id then
		text = ""
	end
	self:ShowText(text)
end

-- The description box: a scroll view holding one text, built anew so it takes the height of the
-- new text ( the scroll view measures its items when it is next drawn or scrolled ).
function sss_menu:ShowText(text)
	self.desc:Clear()
	local t = self.xml:InitTextWnd("tpl:desc_text", self.desc)
	t:SetText(text)
	t:AdjustHeightToText()
	self.desc:ScrollToBegin()
end

function sss_menu:OnPick(key)
	if not self.loading and self.selected ~= key then
		self:SelectRow(key)
	end
end

function sss_menu:OnTrack(key)
	self:UpdateNumber(key)
	self:OnPick(key)
end

function sss_menu:UpdateNumbers(id)
	for _, r in ipairs(ui_sss_menu_data.rows[id]) do
		if r[1] == "t" then
			self:UpdateNumber(r[2])
		end
	end
end

function sss_menu:UpdateNumber(key)
	local c = self.ctl[key]
	local s = c.data[9]
	local v = c.ctrl:GetFValue()
	local x
	if s[3] then
		if v ~= 0 then
			x = s[1] / v + s[2]
		else
			x = 0
		end
	else
		x = s[1] * v + s[2]
	end
	if math.abs(x) < 0.5 * 10 ^ (-s[4]) then
		x = 0
	end
	c.num:SetText(string.format("%." .. s[4] .. "f", x))
end

-- The sun shafts mode. The list has no options_item: it is filled here, shows the console's mode
-- by its name, and only a pick of the player's is written, on "Apply".
function sss_menu:FillRayList(token)
	if self.ray == nil then
		return
	end
	self.ray:ClearList()
	local shown = token or ""
	for i, e in ipairs(ui_sss_menu_data.ray_mode) do
		self.ray:AddItem(e[2], i)
		if e[1] == token then
			shown = game.translate_string(e[2])
		end
	end
	self.ray:SetText(shown)
end

function sss_menu:OnRayMode(key)
	if self.loading then
		return
	end
	local e = ui_sss_menu_data.ray_mode[self.ray:CurrentID()]
	if e ~= nil then
		self.ray_choice = e[1]
	end
	self:OnPick(key)
end

function sss_menu:OnBtnApply()
	local opt = COptionsManager()
	local c = get_console()
	for _, m in ipairs(ui_sss_menu_data.modules) do
		if m[2] == "m" then
			opt:SaveValues(GROUP .. m[1])
		end
	end
	if self.ray_choice ~= nil then
		c:execute(ui_sss_menu_data.ray_command .. " " .. self.ray_choice)
		self.ray_choice = nil
	end

	-- The same hand-over the options dialog's own "Apply" makes ( OnBtnAccept ): from here on
	-- the values in user.ltx are the player's, and the addon's settings scripts leave them alone.
	c:execute("ssfx_menu_configured 1")
	self.kept = nil
	self.kept_cmd = nil

	-- The old SSFX page of the options dialog drives the same commands. It reads them again, so
	-- that applying the options dialog afterwards writes none of its older values back.
	if self.owner.dlg_ssfx ~= nil then
		opt:SetCurrentValues("mm_opt_ssfx")
		opt:SaveBackupValues("mm_opt_ssfx")
	end

	self.owner:SSFXNotifyScripts()
	c:execute("cfg_save")
	self:CloseToMain()

	-- a setting marked * was changed: the message the options dialog shows for its own pages
	if not self.owner.b_restart_system_shown and opt:NeedSystemRestart() then
		self.owner.b_restart_system_shown = true
		self.owner.message_box:InitMessageBox("message_box_restart_game")
		self.owner.message_box:ShowDialog(true)
	end
end

function sss_menu:OnBtnCancel()
	local opt = COptionsManager()
	for _, m in ipairs(ui_sss_menu_data.modules) do
		if m[2] == "m" then
			opt:UndoGroup(GROUP .. m[1])
		end
	end
	self:RestoreKept()
	self.ray_choice = nil
	self:Close()
end

-- "Defaults": the author's values of the module on screen go to the console, and the module is
-- read back from it - the pattern OnBtnKeybDefault of the options dialog uses. NOT
-- SendMessage2Group( "set_default_value" ): a stock slider answers that with the MIDDLE of its
-- range ( UITrackBar.cpp ). A write to the console is outside what COptionsManager can undo, so
-- what it held before is kept, once per command, and goes back on "Cancel".
function sss_menu:OnBtnReset()
	local id = self.current
	if id == nil then
		return
	end
	self.loading = true
	local c = get_console()
	if self.kept == nil then
		self.kept = {}
		self.kept_cmd = {}
	end
	local ray = nil
	for _, r in ipairs(ui_sss_menu_data.rows[id]) do
		local cmd, value = r[7], r[8]
		if not self.kept_cmd[cmd] then
			self.kept_cmd[cmd] = true
			table.insert(self.kept, { cmd, c:get_string(cmd) })
		end
		c:execute(cmd .. " " .. value)
		if r[1] == "r" then
			ray = value
		end
	end
	COptionsManager():SetCurrentValues(GROUP .. id)
	self:UpdateNumbers(id)
	if ray ~= nil then
		self:FillRayList(ray)
		self.ray_choice = nil
	end
	self.loading = false
end

-- "All defaults": what "Defaults" does for the module on screen, for every module at once. The
-- values are those of ui_sss_menu_data - Weather_ATMOS has a copy of its own, read in place of
-- the gamedata one while the addon is on, so with the addon they are the weather package's. Wind
-- Leaves has a window of its own and is not in it. What the console held before is kept for
-- "Cancel", as "Defaults" keeps it. Added 2026-11-05 by _ssfx_work\sss_reset_all_patch.py, not by
-- sss_menu_build.py.
function sss_menu:OnBtnResetAll()
	self.loading = true
	local c = get_console()
	local opt = COptionsManager()
	if self.kept == nil then
		self.kept = {}
		self.kept_cmd = {}
	end
	local ray = nil
	for _, m in ipairs(ui_sss_menu_data.modules) do
		if m[2] == "m" then
			local id = m[1]
			for _, r in ipairs(ui_sss_menu_data.rows[id]) do
				local cmd, value = r[7], r[8]
				if not self.kept_cmd[cmd] then
					self.kept_cmd[cmd] = true
					table.insert(self.kept, { cmd, c:get_string(cmd) })
				end
				c:execute(cmd .. " " .. value)
				if r[1] == "r" then
					ray = value
				end
			end
			opt:SetCurrentValues(GROUP .. id)
			self:UpdateNumbers(id)
		end
	end
	if ray ~= nil then
		self:FillRayList(ray)
		self.ray_choice = nil
	end
	self.loading = false
end

function sss_menu:RestoreKept()
	local kept = self.kept
	self.kept = nil
	self.kept_cmd = nil
	if kept == nil then
		return
	end
	local c = get_console()
	for _, row in ipairs(kept) do
		if row[2] ~= nil then
			c:execute(row[1] .. " " .. row[2])
		end
	end
end

function sss_menu:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false and keyboard_action == ui_events.WINDOW_KEY_PRESSED and dik == DIK_keys.DIK_ESCAPE then
		self:OnBtnCancel()
	end
	return res
end
