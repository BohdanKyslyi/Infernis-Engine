-- @ Description: Infernis PBR - its page of the game's own settings menu

--[[
	Built exactly like the SSFX page ( ui_mm_opt_ssfx.script ): a scroll view, one template
	static per row, the caption and its control inside that row. Every control carries an
	options_item entry in ui_mm_opt.xml, so the engine's own COptionsManager reads and writes
	the console variable - this file only places the controls.

	The first two settings are compiled into the shaders and take effect after the game is
	started again; the sliders are sent to the shaders every frame.

	Generated by _ssfx_work\pbr_page_build.py together with the <pbr> block of ui_mm_opt.xml
	and ui_mm_opt_16.xml - run it again rather than editing here.
--]]

-- { kind, name, lines of caption }
--   kind: "h" heading, "n" note, "t" slider, "l" drop-down list, "c" check box
--   name: the node is "cap_" .. name, and the control "track_" / "list_" / "check_" .. name
local rows = {
	{ "n", "legend", 2 },
	{ "n", "legend2", 2 },

	{ "h", "h_main", 1 },
	{ "c", "enable", 2 },	-- pbr_enable
	{ "l", "sslr_mode", 2 },	-- pbr_sslr_mode

	{ "h", "h_diffuse", 1 },
	{ "t", "sun_diffuse", 1 },	-- pbr_sun_diffuse
	{ "t", "local_diffuse", 1 },	-- pbr_local_diffuse
	{ "t", "ambient_diffuse", 1 },	-- pbr_ambient_diffuse

	{ "h", "h_specular", 1 },
	{ "t", "sun_specular", 1 },	-- pbr_sun_specular
	{ "t", "local_specular", 1 },	-- pbr_local_specular
	{ "t", "ambient_specular", 1 },	-- pbr_ambient_specular
	{ "t", "sun_peak", 1 },	-- pbr_sun_peak
	{ "t", "local_peak", 1 },	-- pbr_local_peak

	{ "h", "h_surface", 1 },
	{ "t", "min_roughness", 1 },	-- pbr_min_roughness
	{ "t", "aa_strength", 1 },	-- pbr_aa_strength
	{ "t", "aa_variance", 1 },	-- pbr_aa_variance
	{ "t", "metal_energy", 2 },	-- pbr_metal_energy
	{ "t", "metal_roughness_gain", 2 },	-- pbr_metal_roughness_gain
}

-- A caption of two or three lines needs a taller row.
local template = { "pbr:templ_item", "pbr:templ_item_2", "pbr:templ_item_3" }

class "opt_pbr" (CUIWindow)

function opt_pbr:__init() super()
end

function opt_pbr:__finalize()
end

function opt_pbr:InitControls(x, y, xml, handler)
	self:SetWndPos(vector2():set(x, y))
	self:SetWndSize(vector2():set(738, 416))
	self:SetAutoDelete(true)

	self.scroll_v = xml:InitScrollView("pbr:scroll_v", self)

	for i = 1, #rows do
		local kind, name = rows[i][1], rows[i][2]
		local st = xml:InitStatic(template[rows[i][3]], self.scroll_v)
		xml:InitStatic("pbr:cap_" .. name, st)
		if kind == "t" then
			xml:InitTrackBar("pbr:track_" .. name, st)
		elseif kind == "l" then
			xml:InitComboBox("pbr:list_" .. name, st)
		elseif kind == "c" then
			xml:InitCheck("pbr:check_" .. name, st)
		end
	end

	local btn
	btn = xml:Init3tButton("pbr:btn_basic", self)
	handler:Register(btn, "btn_pbr_basic")
	btn = xml:Init3tButton("pbr:btn_reset", self)
	handler:Register(btn, "btn_pbr_reset")
end
