-- @ Description: Screen Space Shaders - the settings the SSFX scripts keep for themselves
-- @ Mod: https://www.moddb.com/mods/stalker-anomaly/addons/screen-space-shaders

--[[
	Most SSFX settings end in a console vector a shader reads, and the settings page drives
	those directly. These do not: the weapon DOF, the footsteps in the rain, the three HUD
	raindrop speeds and the auto gloss are inputs to a SCRIPT, which turns them into console
	commands of its own, frame by frame. So the page keeps each of them in a console variable
	of its own ( the engine saves it in user.ltx like any other ) and the script reads it
	from there.

	ssfx_001_mcm.ssfx_get_setting() asks get() below at the point where it would have asked
	Anomaly's MCM, so the SSFX scripts themselves are unchanged. The key is the module and
	the option exactly as the author names them.

	Generated by _ssfx_work\menu_page_build.py - run it again rather than editing here.
--]]

-- [ "module/option" ] = { console command, true for a check box }
local vars = {
	-- ssfx_rain_hud_raindrops
	["ssfx_rain_hud_raindrops/animation_speed"] = { "ssfx_ui_drops_animation_speed", false },
	["ssfx_rain_hud_raindrops/buildup"] = { "ssfx_ui_drops_buildup", false },
	["ssfx_rain_hud_raindrops/drying"] = { "ssfx_ui_drops_drying", false },
	-- ssfx_rain_footsteps
	["ssfx_rain_footsteps/main_vol"] = { "ssfx_ui_fs_main_vol", false },
	["ssfx_rain_footsteps/vol_rnd"] = { "ssfx_ui_fs_vol_rnd", false },
	["ssfx_rain_footsteps/multi_no_rain"] = { "ssfx_ui_fs_multi_no_rain", false },
	["ssfx_rain_footsteps/multi_walk"] = { "ssfx_ui_fs_multi_walk", false },
	["ssfx_rain_footsteps/multi_run"] = { "ssfx_ui_fs_multi_run", false },
	["ssfx_rain_footsteps/jump_vol"] = { "ssfx_ui_fs_jump_vol", false },
	["ssfx_rain_footsteps/land_vol"] = { "ssfx_ui_fs_land_vol", false },
	-- wpn_dof
	["wpn_dof/aim_fadestart"] = { "ssfx_ui_wdof_aim_fadestart", false },
	["wpn_dof/aim_fadelen"] = { "ssfx_ui_wdof_aim_fadelen", false },
	["wpn_dof/aim_blur"] = { "ssfx_ui_wdof_aim_blur", false },
	["wpn_dof/aim_edgeblur"] = { "ssfx_ui_wdof_aim_edgeblur", false },
	["wpn_dof/fadestart"] = { "ssfx_ui_wdof_fadestart", false },
	["wpn_dof/fadelen"] = { "ssfx_ui_wdof_fadelen", false },
	["wpn_dof/blur"] = { "ssfx_ui_wdof_blur", false },
	["wpn_dof/edgeblur"] = { "ssfx_ui_wdof_edgeblur", false },
	["wpn_dof/reloading"] = { "ssfx_ui_wdof_reloading", true },
	["wpn_dof/pda"] = { "ssfx_ui_wdof_pda", true },
	["wpn_dof/inventory"] = { "ssfx_ui_wdof_inventory", true },
	["wpn_dof/fdda"] = { "ssfx_ui_wdof_fdda", true },
	["wpn_dof/looting_mutant"] = { "ssfx_ui_wdof_looting_mutant", true },
	-- ssfx_gloss
	["ssfx_gloss/auto_gloss"] = { "ssfx_ui_gloss_auto_gloss", true },
	["ssfx_gloss/auto_gloss_max"] = { "ssfx_ui_gloss_auto_gloss_max", false },
}

-- The value the menu holds for one option, or nil if the option is not one of these.
-- A module that sits under a parent page is asked for with the parent in front
-- ( "ssfx_rain_module/ssfx_rain_footsteps" ); the last part is the module itself.
function get(module_name, var_name)
	local module_id = string.match(module_name, "([^/]+)$")
	if not module_id then
		return nil
	end
	local v = vars[module_id .. "/" .. var_name]
	if not v then
		return nil
	end
	if v[2] then
		return get_console():get_bool(v[1])
	end
	return get_console():get_float(v[1])
end
