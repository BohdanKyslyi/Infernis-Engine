-- If you're not using MCM you can customize your settings here --

-- Infernis: pom_refine and grass_align are the author's MCM defaults ( ssfx_terrain_mcm.script,
-- false both ) and not the 0 and 0.0 this file shipped with. Lua takes any number for true, so
-- those switched both ON ( ssfx_terrain.script tests them with "and 1 or 0" ) - which the
-- defaults button of the native settings page never does. This table is what a new profile runs
-- on until that page is applied.

ssfx_default_settings =
{
	["distance"]			= 8.0,

	["pom_quality"]			= 12,
	["pom_refine"]			= false,

	["pom_range"]			= 20,
	["pom_height"]			= 0.04,
	["pom_water_level"]		= 1.0,

	["grass_align"]			= false,
	["grass_slope"]			= 90.0,
}

